# Database Configuration (PostgreSQL)
DB_CLIENT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=co_tuong_db

# Connection Pool Settings
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Application Port
PORT=5000

# Môi trường chạy: development | test | production
NODE_ENV=development

# SEC-01: Chỉ bật true khi demo/dev. KHÔNG bật khi deploy.
# Khi false (mặc định), token OAuth dạng "mock_..." bị từ chối 401.
ALLOW_MOCK_OAUTH=false

# FE-09: dev/prod đều dùng đường dẫn tương đối + proxy của Vite (xem vite.config.js).
# Chỉ đặt VITE_API_URL khi backend nằm ở domain khác (vd https://api.example.com/api).
VITE_API_URL=/api

# SEC-05: Google OAuth là tuỳ chọn. Để trống -> nút Google bị ẩn.
VITE_GOOGLE_CLIENT_ID=

# REV-08: đây là biến SHELL dùng cho proxy của Vite dev (vite.config.js), không phải
# biến nhúng vào bundle. Mặc định http://127.0.0.1:5000. Ví dụ: VITE_BACKEND_URL=http://127.0.0.1:5000 npm run dev
# VITE_BACKEND_URL=http://127.0.0.1:5000

# FE-07: ICE server cho WebRTC (JSON). Để trống -> dùng STUN mặc định của Google.
# Thêm TURN khi hai người chơi ở sau NAT đối xứng:
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]
